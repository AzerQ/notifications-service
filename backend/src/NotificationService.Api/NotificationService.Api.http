### ===================================================================
### Notification Service API - Comprehensive Test Suite
### ===================================================================
### Этот файл содержит тесты для всех эндпоинтов NotificationService API
### Включает аутентификацию, CRUD операции и специальные функции
### ===================================================================

# Переменные окружения
@baseUrl = http://localhost:5093
@contentType = application/json

# Тестовые пользователи из конфигурации
@adminEmail = admin@examle.com
@testUserEmail = test@examle.com
@testUser2Email = test2@examle.com
@testUser3Email = test3@examle.com

# ID пользователей из seed данных
@adminUserId = b606cd21-7260-45b3-9e6f-6053690add9a
@testUserId = 9490fae9-2a4c-4545-8025-7dd3bf8397ec
@testUser2Id = a3b1c2d3-e4f5-6789-0abc-def123456789
@testUser3Id = 5773919a-49b8-49ff-907f-8dca50791f51

# Динамические переменные (будут заполнены в процессе тестирования)
@accessToken = 
@refreshToken = 
@notificationId = Set notification ID

### ===================================================================
### 📧 АУТЕНТИФИКАЦИЯ - Authentication Controller
### ===================================================================

### 1. Отправка кода верификации на email - Admin
# @name sendVerificationCodeAdmin
POST {{baseUrl}}/api/Auth/email/sendCode?email={{adminEmail}}
Content-Type: {{contentType}}

### 2. Отправка кода верификации на email - Test User
# @name sendVerificationCodeTestUser
POST {{baseUrl}}/api/Auth/email/sendCode?email={{testUserEmail}}
Content-Type: {{contentType}}

### 3. Авторизация по email и коду
# @name loginByEmail
# @prompt challengeId Generated email verify challenge id
# @prompt code Email challenge code (send to email inbox)
POST {{baseUrl}}/api/Auth/email
Content-Type: {{contentType}}

{
  "id": "{{challengeId}}",
  "code": "{{code}}"
}

### 5. Windows аутентификация (требует настройки IIS)
# @name windowsAuth
POST {{baseUrl}}/api/Auth/windows
Content-Type: {{contentType}}
# Windows-Identity: DOMAIN\username

### 6. Обновление access токена
# @name refreshAccessToken
POST {{baseUrl}}/api/Auth/refresh
Content-Type: {{contentType}}

{
  "refreshTokenValue": "{{refreshToken}}"
}

### ===================================================================
### 🔔 УВЕДОМЛЕНИЯ - Notification Controller
### ===================================================================

### 7. Создание уведомления - простой пример
# @name createNotification
POST {{baseUrl}}/api/Notification/System/SystemAlert
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "title": "Системное уведомление",
  "message": "Это тестовое системное уведомление",
  "channels": ["Email", "InApp"],
  "templateData": {
    "userName": "Тестовый пользователь",
    "alertType": "info",
    "timestamp": "2024-11-09T18:40:00Z"
  }
}

### 8. Создание уведомления с категорией User
# @name createUserNotification
POST {{baseUrl}}/api/Notification/User/UserRegistered
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "userId": "{{testUserId}}",
  "welcomeMessage": "Добро пожаловать в систему!"
}

### 9. Создание уведомления с категорией Task
# @name createTaskNotification
POST {{baseUrl}}/api/Notification/Task/TaskAssigned
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "assigneeId": "{{testUserId}}",
  "assignerId": "{{adminUserId}}",
  "taskTitle": "Разработка новой функции",
  "taskDescription": "Необходимо реализовать новую функцию в системе уведомлений",
  "priority": "High",
  "dueDate": "2024-12-01T23:59:59Z"
}

### 10. Создание уведомления с категорией Order
# @name createOrderNotification
POST {{baseUrl}}/api/Notification/Order/OrderCreated
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "customerId": "{{testUserId}}",
  "orderNumber": "ORD-2024-001",
  "orderTotal": 1599.99,
  "itemCount": 3
}

### 11. Получение уведомления по ID
# @name getNotificationById
# @prompt notificationId Id of random notification
GET {{baseUrl}}/api/Notification/{{notificationId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 12. Получение персональных уведомлений пользователя
# @name getUserNotifications
GET {{baseUrl}}/api/Notification/personal?onlyUnread=false&pageSize=10&pageNumber=1
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 13. Получение только непрочитанных уведомлений
# @name getUnreadNotifications
GET {{baseUrl}}/api/Notification/personal?onlyUnread=true&pageSize=50&pageNumber=1
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 14. Поиск уведомлений (только для Admin)
# @name searchNotifications
POST {{baseUrl}}/api/Notification/search
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "filters": [
    {
      "field": "Title",
      "operator": 1,
      "value": "Системное",
      "logic": 0
    }
  ],
  "sort": [
    {
      "field": "CreatedAt",
      "direction": 1
    }
  ],
  "page": 1,
  "pageSize": 20,
  "includes": ["Recipient", "Template"],
  "includeTotalCount": true
}

### 15. Расширенный поиск с множественными фильтрами
# @name advancedSearch
POST {{baseUrl}}/api/Notification/search
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "filters": [
    {
      "field": "CreatedAt",
      "operator": 4,
      "value": "2024-11-01T00:00:00Z",
      "logic": 0
    },
    {
      "field": "NotificationWasRead",
      "operator": 0,
      "value": false,
      "logic": 0
    }
  ],
  "sort": [
    {
      "field": "CreatedAt",
      "direction": 1
    }
  ],
  "page": 1,
  "pageSize": 100
}

### 16. Установка флага прочтения уведомления
# @name setNotificationReadFlag
PUT {{baseUrl}}/api/Notification/set-read-flag?notificationId={{notificationId}}&flagValue=true
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 17. Отмена флага прочтения уведомления
# @name setNotificationUnreadFlag
PUT {{baseUrl}}/api/Notification/set-read-flag?notificationId={{notificationId}}&flagValue=false
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 18. Трансляция уведомления через SignalR (только Admin)
# @name broadcastNotification
POST {{baseUrl}}/api/Notification/broadcast
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "id": "broadcast-001",
  "type": "system",
  "title": "Системное объявление",
  "content": "Запланировано техническое обслуживание системы",
  "date": "2024-11-09T18:40:00Z",
  "read": false,
  "author": "Системный администратор",
  "actions": [
    {
      "name": "view_details",
      "label": "Подробнее",
      "url": "appaction://showDetails?id=broadcast-001"
    }
  ],
  "hashtags": ["maintenance", "system", "announcement"],
  "parameters": [
    {
      "key": "priority",
      "value": "high",
      "description": "Приоритет уведомления"
    }
  ]
}

