### 27. Тестирование полного цикла уведомления
# @name fullNotificationCycle
POST {{baseUrl}}/api/Notification/Test/ComplexScenario
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "title": "Комплексное тестовое уведомление",
  "message": "Это уведомление для тестирования полного цикла обработки",
  "channels": ["Email", "InApp", "Push"],
  "templateData": {
    "userName": "{{testUserId}}",
    "testScenario": "full_cycle",
    "complexity": "high",
    "timestamp": "2024-11-09T18:40:00Z"
  },
  "metadata": [
    {
      "key": "test_type",
      "value": "integration",
      "description": "Тип интеграционного теста"
    },
    {
      "key": "environment",
      "value": "development",
      "description": "Среда выполнения теста"
    }
  ]
}

