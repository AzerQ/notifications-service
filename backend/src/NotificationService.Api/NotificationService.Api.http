### ===================================================================
### ⚙️ НАСТРОЙКИ МАРШРУТОВ - User Route Preferences Controller
### ===================================================================

### 23. Получение настроек маршрутов пользователя
# @name getUserRoutePreferences
GET {{baseUrl}}/api/users/{{testUserId}}/routes
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 24. Получение настроек маршрутов для Admin пользователя
# @name getAdminRoutePreferences
GET {{baseUrl}}/api/users/{{adminUserId}}/routes
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 25. Обновление настроек маршрутов уведомлений
# @name updateUserRoutePreferences
PUT {{baseUrl}}/api/users/{{testUserId}}/routes
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

[
  {
    "route": "System/SystemAlert",
    "enabled": true
  },
  {
    "route": "User/UserRegistered",
    "enabled": true
  },
  {
    "route": "Task/TaskAssigned",
    "enabled": true
  },
  {
    "route": "Task/TaskCompleted",
    "enabled": false
  },
  {
    "route": "Order/OrderCreated",
    "enabled": true
  },
  {
    "route": "Order/OrderCancelled",
    "enabled": false
  }
]

### 26. Отключение всех уведомлений для пользователя
# @name disableAllNotifications
PUT {{baseUrl}}/api/users/{{testUser2Id}}/routes
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

[
  {
    "route": "System/SystemAlert",
    "enabled": false
  },
  {
    "route": "User/UserRegistered",
    "enabled": false
  },
  {
    "route": "Task/TaskAssigned",
    "enabled": false
  },
  {
    "route": "Order/OrderCreated",
    "enabled": false
  }
]

